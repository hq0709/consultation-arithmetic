# ============================================================
#  密钥：绝不提交
#  （注意：.gitignore 不支持行尾注释，注释必须独占一行）
# ============================================================
.env
.env.*
!.env.example
*.key
*_token
.config/

# ============================================================
#  论文在独立仓库：hq0709/medical-agent-scaling
# ============================================================
paper/

# ============================================================
#  派生产物：可由代码重建，体积过大
#    cache/   LLM 响应缓存 ~441 MB
#    results/*.jsonl  原始 episode ~353 MB（单文件最大 113 MB，超 GitHub 限制）
# ============================================================
cache/
logs/
refine-logs/
results/*.jsonl
# 子目录里的原始数据同样不进仓库 —— results/*.jsonl 匹配不到子目录
results/**/*.jsonl
results/_superseded/
results/results/
# flock 的锁文件：运行时产物
*.lock
__pycache__/
*.pyc
.ipynb_checkpoints/

# ============================================================
#  基准数据不转载，用 data/build_datasets.py 重建
# ============================================================
data/*.jsonl
data_local/

# ============================================================
#  聚合结果保留：体积小，论文正文直接引用
# ============================================================
!results/*.json

# ============================================================
#  内部工作笔记：不进公开仓库
#    fulltext.txt  是他人论文全文（版权）
#    NMI_*.md      逐节对标笔记，公开会削弱本文的原创性定位
# ============================================================
docs/NMI_*
docs/GAP_ANALYSIS.md
CLAUDE.md
MANIFEST.md

# 论文 PDF 属于论文仓，不属于这里（曾因 cp 到错误目录混入一次）
main.pdf
