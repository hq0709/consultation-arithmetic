# 复制为 .env 后填入。.env 已被 .gitignore 排除，绝不要提交。

# ---- OpenAI（闭源模型臂）----
OPENAI_API_KEY=sk-...

# ---- 跨进程日花费上限（美元）。common/llm.py 用文件锁强制执行 ----
DAILY_CAP_USD=25

# ---- 并发。gpt-5-nano 在 32 并发下会 429，18 是实测安全值 ----
LLM_MAX_INFLIGHT=18
LLM_WORKERS=8

# ---- 推理模型的最小输出预算。给太小会因推理 token 吃光额度而返回空串 ----
REASONING_MIN_TOKENS=1600

# ---- 开源权重模型臂（vLLM 的 OpenAI 兼容端点）----
# 模型在代码中以 "local/<name>" 引用，name 必须与 --served-model-name 一致。
# LOCAL_MODELS=medgemma-4b=http://localhost:8010/v1,lingshu-7b=http://localhost:8011/v1
# 只有一个端点时也可以只设 VLLM_BASE_URL：
# VLLM_BASE_URL=http://localhost:8010/v1
